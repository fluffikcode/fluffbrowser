# FluffBrowser configuration — copy this file to ".env" and fill in your values.
# Values here override the CONFIG block in startbrowser.py.
# ".env" is git-ignored, so your key never reaches GitHub.

FLUFFBROWSER_BASE_URL=http://localhost:1234/v1
FLUFFBROWSER_API_KEY=your-api-key
FLUFFBROWSER_MODEL=your-model-name

# ── Optional tuning ──────────────────────────────────────────────────────
# FLUFFBROWSER_TEMPERATURE=0.0
# FLUFFBROWSER_MAX_STEPS=15
# FLUFFBROWSER_TIMEOUT=600
# FLUFFBROWSER_HEADLESS=false
# FLUFFBROWSER_BROWSER_TYPE=chromium

# ── Privacy ──────────────────────────────────────────────────────────────
# Switches off browser-use's anonymised usage statistics.
# ANONYMIZED_TELEMETRY=false
